# 서울시 오픈API (열차 위치 + 도착 정보)
SEOUL_API_KEY=your_seoul_api_key

# ODsay API (경로 검색)
ODSAY_API_KEY=your_odsay_api_key

# Claude API — 레일봇(교육 > 레일봇)과 운전정보 사진 자동 추출에 쓴다.
# 없으면 그 두 기능만 "아직 켜져 있지 않아요" 안내를 내보내고 나머지 앱은 정상 동작한다.
# ★ 반드시 서버 전용 — NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 키가 그대로 실린다.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# 운영 스크립트(scripts/upload-*.js)용 작성자 정보
# 저장소가 공개라 실명·사번을 코드에 넣지 않고 여기서 주입한다.
AUTHOR_NAME=작성자이름
AUTHOR_SABUN=00000000
