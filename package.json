{
  "name": "train-dia",
  "version": "2.0.0",
  "private": true,
  "description": "답십리 기관사 DIA — 서울교통공사 5호선 교번 관리 시스템",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "check:hover": "node scripts/check-no-raw-hover.cjs src",
    "check:surface-3d": "node scripts/check-surface-3d.mjs",
    "check:surface-3d:staged": "node scripts/check-surface-3d.mjs --staged",
    "check:surface-3d:changed": "node scripts/check-surface-3d.mjs --changed",
    "check:theme-override": "node scripts/check-theme-override.mjs",
    "check:theme-override:staged": "node scripts/check-theme-override.mjs --staged",
    "check:theme-override:changed": "node scripts/check-theme-override.mjs --changed",
    "check:card-rhythm": "node scripts/check-card-rhythm.mjs",
    "check:card-rhythm:staged": "node scripts/check-card-rhythm.mjs --staged",
    "check:card-rhythm:changed": "node scripts/check-card-rhythm.mjs --changed",
    "check:text-size": "node scripts/check-text-size.mjs",
    "check:text-size:staged": "node scripts/check-text-size.mjs --staged",
    "check:text-size:changed": "node scripts/check-text-size.mjs --changed",
    "check:hooks": "node scripts/ensure-hooks.mjs",
    "install:hooks": "node scripts/install-hooks.mjs",
    "check:quality-gates": "npm run check:hooks && npm run check:hover && npm run check:surface-3d:changed && npm run check:theme-override:changed && npm run check:card-rhythm:changed && npm run check:text-size:changed",
    "check:quality-gates:full": "npm run check:quality-gates && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@supabase/supabase-js": "^2.47.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.575.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.183.2",
    "web-push": "^3.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.0",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0",
    "supabase": "^2.98.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "xlsx": "^0.18.5"
  }
}
