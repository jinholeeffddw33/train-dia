# 서울시 오픈API (열차 위치 + 도착 정보)
SEOUL_API_KEY=your_seoul_api_key

# ODsay API (경로 검색)
ODSAY_API_KEY=your_odsay_api_key

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# 운영 스크립트(scripts/upload-*.js)용 작성자 정보
# 저장소가 공개라 실명·사번을 코드에 넣지 않고 여기서 주입한다.
AUTHOR_NAME=작성자이름
AUTHOR_SABUN=00000000
