{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://train-dia.local/schemas/rules-registry.schema.json",
  "title": "train-dia Rule Registry",
  "description": "Schema for docs/rules/registry.json — machine-readable rule SSOT. ZINOSB 이식본(2026-06-23), train-dia 게이트 구성에 맞게 적응(2026-08-09). Validated by scripts/docs-validate.mjs.",
  "type": "object",
  "required": ["version", "lastUpdated", "domains", "ruleIds", "decisionQueue", "verificationCommands"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Local relative path to this schema (./registry.schema.json)."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer. Bump major when domain/rule contract breaks."
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date YYYY-MM-DD. docs-validate flags >90d as stale."
    },
    "description": {
      "type": "string"
    },
    "verificationCommands": {
      "type": "object",
      "description": "Named npm scripts AI/CI runs at gate points. train-dia 적응: rules(ai-rule-guard)/conflicts(docs-conflict-scan)는 아직 미이식이라 optional — 이식 시 required 로 승격.",
      "required": ["preCommit", "docs"],
      "additionalProperties": { "type": "string" },
      "properties": {
        "preCommit": { "type": "string" },
        "rules": { "type": "string" },
        "docs": { "type": "string" },
        "conflicts": { "type": "string" },
        "hooks": { "type": "string" },
        "typecheck": { "type": "string" }
      }
    },
    "domains": {
      "type": "object",
      "description": "Domain → mustRead docs + file patterns + verification commands.",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": ["description", "mustRead", "filePatterns", "verification"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string", "minLength": 4 },
            "mustRead": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 4 }
            },
            "filePatterns": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 2 }
            },
            "verification": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ruleIds": {
      "type": "object",
      "description": "Rule ID → canonical doc + severity + scope.",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Z]+(-[A-Z0-9]+)+-\\d{3}$": {
          "type": "object",
          "required": ["description", "canonical", "severity", "scope"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string", "minLength": 6 },
            "canonical": { "type": "string", "minLength": 4 },
            "severity": { "type": "string", "enum": ["fail", "warn", "info"] },
            "scope": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "exceptions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "autoCheck": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "decisionQueue": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
